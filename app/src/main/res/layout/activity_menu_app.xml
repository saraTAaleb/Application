        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Log_out"
            android:textColor="#E40E10"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

